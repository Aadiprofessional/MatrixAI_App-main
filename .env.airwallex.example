# Airwallex Configuration
# Copy this file to .env and fill in your actual credentials

# Airwallex Sandbox Credentials
# Get these from: https://www.airwallex.com/app/settings/api
AIRWALLEX_CLIENT_ID=your_sandbox_client_id_here
AIRWALLEX_API_KEY=your_sandbox_api_key_here

# Environment (sandbox or production)
AIRWALLEX_ENVIRONMENT=sandbox

# Production Credentials (only set when ready for production)
# AIRWALLEX_PROD_CLIENT_ID=your_production_client_id_here
# AIRWALLEX_PROD_API_KEY=your_production_api_key_here

# Instructions:
# 1. Create a sandbox account at https://www.airwallex.com/
# 2. Navigate to Account > Developer > API keys
# 3. Generate your sandbox Client ID and API key
# 4. Copy this file to .env and replace the placeholder values
# 5. Restart your React Native app

# Security Notes:
# - Never commit your actual .env file to version control
# - Keep your API keys secure and rotate them regularly
# - Use different credentials for development and production